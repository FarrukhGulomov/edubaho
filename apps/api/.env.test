# Testlar uchun ALOHIDA muhit — hech qachon production/dev DB'ga ulanmaydi.
# Docker Compose muhitida (local dev) 5433/6379 portlaridan, CI'da esa
# native postgres/redis xizmatlaridan foydalanish mumkin — muhim bo'lgani:
# DB nomi har doim "..._test" bilan tugashi va production'dan MUTLAQO
# alohida bo'lishi kerak.
NODE_ENV=test
DATABASE_URL=postgresql://edureyting_user:edureyting_secret@localhost:5432/edureyting_test
DIRECT_URL=postgresql://edureyting_user:edureyting_secret@localhost:5432/edureyting_test
REDIS_URL=redis://localhost:6379/1

JWT_SECRET=test-jwt-secret-do-not-use-in-prod-0000000
REFRESH_SECRET=test-refresh-secret-do-not-use-in-prod-1111
ADMIN_PIN=147258
ALLOWED_ORIGINS=http://localhost:3000

# SMS_LOGIN=test → sendSmsOtp() haqiqiy tarmoq so'rovi yubormaydi, OTP'ni
# faqat konsolga chiqaradi (testlar hech qachon tashqi SMS shlyuziga
# ulanmasligi kerak)
SMS_LOGIN=test
